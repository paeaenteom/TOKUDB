{
  "cleanUrls": true,
  "regions": [
    "hnd1"
  ],
  "rewrites": [
    { "source": "/i/(.*)", "destination": "/api/img?p=$1" },
    { "source": "/summ/(.*)", "destination": "/api/char?p=$1" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/IMG", "destination": "/DB/search" },
    { "source": "/IMG/(.*)", "destination": "/DB/search" },
    { "source": "/DB/(.+)", "destination": "/api/meta?p=$1" }
  ]
}
